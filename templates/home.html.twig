{% extends "base.html.twig" %}
{% block title %}{{ parent() }}Accueil{% endblock %}
{% block content %}
  <div class="text-center">
    <h1>BIENVENUE SUR MON SITE</h1>
    <div class="row row-cols-1 row-cols-md-4 g-4">
      {% for article in articles %}
        <div class="col">
          <div class="card">
            {% if article.image %}
              <img src="images/{{ article.image }}" class="card-img-top" alt="{{ article.sujet }}">
            {% endif %}
            <div class="card-body">
              <h5 class="card-title">{{ article.sujet }}</h5>
              {# on affiche seulement le début du contenu (sans les balises des anciens articles) #}
              <p class="card-text">{{ article.contenu|striptags|slice(0, 100) }}...</p>
              <a href="index.php?page=lirearticle&Article={{ article.id }}" class="btn btn-primary">lire la suite</a>
            </div>
            <div class="card-footer">
              {{ article.datedepublication|date("d-m-Y à H:i") }}
            </div>
          </div>
        </div>
      {% else %}
        <p>Aucun article pour le moment.</p>
      {% endfor %}
    </div>
  </div>
{% endblock %}
