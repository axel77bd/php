{% extends "base.html.twig" %}
{% block title %}{{ parent() }}Ajout Categorie{% endblock %}
{% block content %}
  <h1 class="text-dark text-center">Ajouter une catégorie</h1>
  <form action="index.php?page=ajout_categorie" method="post">
    <div class="row">
      <div class="col-12 col-md-6">
        <div>
          <label for="exampleInputSujet" class="form-label mt-4">categorie</label>
          <input name="categorie" type="text" class="form-control" id="exampleInputSujet" placeholder="ENTRER LA CATEGORIE">
        </div>
        <div>
          <button name="valider" type="submit" class="btn btn-primary mt-4">valider</button>
        </div>
      </div>
    </div>
  </form>
{% endblock %}
