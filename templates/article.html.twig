{% extends "base.html.twig" %}
{% block title %}{{ parent() }}Article{% endblock %}
{% block content %}
  <h1 class="text-dark text-center">Article</h1>
  {# enctype permet de preciser comment on envoie les données, quand on envoie un fichier il faut mettre multipart/form-data #}
  <form action="index.php?page=article" method="post" enctype="multipart/form-data">
    <div class="row">
      <div class="col-12 col-md-6">
        <div>
          <label for="exampleInputSujet" class="form-label mt-4">Sujet</label>
          <input name="sujet" type="text" class="form-control" id="exampleInputSujet" placeholder="Enter le Sujet">
        </div>
        <div>
          <label for="exampleTextarea" class="form-label mt-4">Contenu</label>
          <textarea name="contenu" class="form-control" id="exampleTextarea" rows="3"></textarea>
        </div>
        <div class="mt-4">
          <input name="image" class="form-control" type="file">
        </div>
        <div class="mt-4">
          {% for categorie in categories %}
            <div class="form-check">
              <input value="{{ categorie.id }}" class="form-check-input" name="categories[]" type="checkbox" id="categorie{{ categorie.id }}">
              <label class="form-check-label" for="categorie{{ categorie.id }}">{{ categorie.nom }}</label>
            </div>
          {% endfor %}
        </div>
        <div>
          <button name="valider" type="submit" class="btn btn-primary mt-4">valider</button>
        </div>
      </div>
    </div>
  </form>
{% endblock %}
